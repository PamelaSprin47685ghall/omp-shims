{
  "name": "omp-shims",
  "version": "1.0.0",
  "description": "Portable, individually switchable compatibility shims for the OMP auth-gateway (plugin bridge, tool-id hashing, Antigravity request repair, IPv6-first fetch, traffic logging).",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./preload": "./preload.js",
    "./registry-capture": "./registry-capture.js",
    "./config": "./lib/config.js",
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./index.js"
    ]
  },
  "omp": {
    "extensions": [
      "./index.js"
    ]
  },
  "bin": {
    "omp-shims": "./bin/omp-shims.js"
  },
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "test": "bun test",
    "ci": "biome ci . && bun test"
  },
  "files": [
    "index.js",
    "preload.js",
    "registry-capture.js",
    "lib/",
    "features/",
    "vendor/",
    "systemd/",
    "bin/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PamelaSprin47685ghall/omp-shims.git"
  },
  "homepage": "https://github.com/PamelaSprin47685ghall/omp-shims#readme",
  "bugs": {
    "url": "https://github.com/PamelaSprin47685ghall/omp-shims/issues"
  },
  "keywords": [
    "oh-my-pi",
    "omp",
    "pi",
    "auth-gateway",
    "plugin",
    "shim",
    "antigravity",
    "kiro",
    "commandcode"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
