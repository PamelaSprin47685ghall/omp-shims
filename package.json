{
  "name": "omp-shims",
  "version": "2.0.0",
  "description": "Portable, individually switchable compatibility shims for the OMP auth-gateway (plugin bridge, tool-id shortening, Antigravity request repair, IPv6-first fetch, traffic logging).",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./preload": "./preload.mjs",
    "./registry-capture": "./registry-capture.mjs",
    "./config": "./lib/config.mjs",
    "./contracts": "./lib/contracts.mjs",
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./index.mjs"
    ]
  },
  "omp": {
    "extensions": [
      "./index.mjs"
    ]
  },
  "bin": {
    "omp-shims": "./bin/omp-shims.mjs"
  },
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "build:status-page": "bun scripts/build-status-page.mjs",
    "build:status-page:check": "bun scripts/build-status-page.mjs --check",
    "test": "bun test",
    "ci": "biome ci . && bun test",
    "prepublishOnly": "bun run ci"
  },
  "files": [
    "index.mjs",
    "antigravity-unpause.mjs",
    "preload.mjs",
    "registry-capture.mjs",
    "lib/",
    "lib/router/status-page/dist/",
    "features/",
    "presets/",
    "vendor/",
    "systemd/",
    "bin/",
    "scripts/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PamelaSprin47685ghall/omp-shims.git"
  },
  "homepage": "https://github.com/PamelaSprin47685ghall/omp-shims#readme",
  "bugs": {
    "url": "https://github.com/PamelaSprin47685ghall/omp-shims/issues"
  },
  "keywords": [
    "oh-my-pi",
    "omp",
    "pi",
    "auth-gateway",
    "plugin",
    "shim",
    "antigravity",
    "kiro",
    "commandcode"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "framework7": "9.3.0",
    "framework7-svelte": "9.3.0",
    "svelte": "5.57.3",
    "vite": "8.3.7"
  }
}
