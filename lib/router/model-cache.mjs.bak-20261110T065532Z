// Read-only view of OMP's official model cache.
//
// The gateway keeps each provider's full model metadata (context, limits,
// reasoning, thinking levels, base URL) in models.db. Its /v1/models answer
// omits the reasoning fields, and the compiled OMP binary does not expose
// ModelRegistry to the preload hook. This cache is therefore the reliable
// capability source for built-in providers.
//
// Reads are per provider, cached for 30 seconds, and never throw. A missing
// file, a locked database, or an old schema falls back to an empty map.

import { Database } from "bun:sqlite";
import { existsSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, join } from "node:path";

export const MODEL_CACHE_TTL_MS = 30_000;

const entries = new Map();

/** The models.db path that sits next to agent.db. */
export function modelsDbPath(agentDbPath) {
  return agentDbPath ? join(dirname(agentDbPath), "models.db") : join(homedir(), ".omp", "agent", "models.db");
}

/**
 * Models of one provider from the official cache, keyed by "provider/id".
 * @param {string} provider
 * @param {{path?: string, now?: () => number}} [options]
 * @returns {Map<string, object>}
 */
export function officialModels(provider, { path = modelsDbPath(), now = Date.now } = {}) {
  if (typeof provider !== "string" || provider === "") return new Map();
  const at = now();
  const held = entries.get(provider);
  if (held && at - held.at < MODEL_CACHE_TTL_MS && held.path === path) return held.byRef;

  const byRef = new Map();
  if (existsSync(path)) {
    let db;
    try {
      db = new Database(path, { readonly: true });
      const row = db.query("select models from model_cache where provider_id = ?").get(provider);
      const models = row?.models ? JSON.parse(row.models) : undefined;
      if (Array.isArray(models)) {
        for (const model of models) {
          if (model?.provider && model?.id) byRef.set(`${model.provider}/${model.id}`, model);
        }
      }
    } catch {
      // A locked or older cache is not fatal.
    } finally {
      try {
        db?.close();
      } catch {
        // Closing a broken handle must not fail the lookup.
      }
    }
  }
  entries.set(provider, { at, path, byRef });
  return byRef;
}

/** Forget cached reads. */
export function clearOfficialModelCache() {
  entries.clear();
}
